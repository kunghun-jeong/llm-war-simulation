# API 키 설정 파일
# 이 파일을 복사해서 .env 로 저장하고 실제 키를 입력하세요
# .env 파일은 절대 GitHub에 올리지 마세요!

# ── 무료: Groq (llama / gemma / qwen / deepseek_r1 팀) ──
# 발급: https://console.groq.com/
GROQ_API_KEY=gsk_...

# ── 유료: 상용 API (선택사항) ────────────────────────────
# 발급: https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-...

# 발급: https://console.anthropic.com/
ANTHROPIC_API_KEY=sk-ant-...

# 발급: https://aistudio.google.com/app/apikey
GOOGLE_API_KEY=AIza...

# 발급: https://platform.deepseek.com/
DEEPSEEK_API_KEY=sk-...
